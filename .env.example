# Copy to .env for local runs; in deployment set these as service variables instead.

# Google AI Studio key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Bearer token clients must send: Authorization: Bearer <LITELLM_MASTER_KEY>
# Must start with "sk-". Generate one, e.g.: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-
